# Local environment files (never commit credentials)
.env
.env.*
!.env.example
__pycache__/
*.py[cod]

# Hosting build output
.vercel/

# Wrangler / Cloudflare
.wrangler/
.dev.vars
.dev.vars.*

# Local run state written by development tooling (logs, pids, scratch files)
.local-run/

# Editor/agent project markers that are per-machine, not application source
.freebuff/

# Supabase CLI link state (holds the project ref, regenerated by `supabase link`)
supabase/.temp/

# Downloaded MIT OpenCourseWare mirror and the exported Lovable asset tree.
# These are inputs for scripts/ingest-mit-course.mjs, not project source: the
# course is already seeded in Supabase and the PDFs learners open live in
# public/course/. Restoring them is documented in docs/LOCAL_SETUP.md.
# Root-anchored on purpose so source paths such as src/routes/api/resources/
# and public/course/ stay tracked.
/download/
/external-resources/
/lists/
/pages/
/resources/
/static_resources/
/static_shared/
/video_galleries/
/content_map.json
/data.json

# Local Whisper source, build, model weights and private inference outputs.
/whisper.cpp/

# Root-level documents of the downloaded mirror. Horizon's own HTML is rendered
# by TanStack Start (src/routes/index.tsx) and its static files are served from
# public/, so a committed root index.html is published as the whole site by a
# static Vercel preset and buries the app. Keep these out of the repository.
/index.html
/sitemap.xml
/robots.txt
/favicon.ico

# TypeScript incremental build metadata
*.tsbuildinfo

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
.env*
!.env.example
/.local-backups/
