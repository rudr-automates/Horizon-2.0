[TEMPLATE]
# Copy this file to `.env` and fill in your own values.
# `.env*` files are ignored by Git. Never commit real credentials.
#
# Supabase project settings (Project Settings -> API).
# These two are browser-safe: the publishable key is designed for client use and
# is still protected by Row Level Security. Do not put a service-role/secret key
# in a VITE_* variable or anywhere that reaches the browser bundle.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=

# Server-only credentials for local migrations, seeding and type generation.
# The running application does not read these.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only free-tier AI providers. Gemini is primary; Groq is the bounded
# fallback. Jina provides 1,024-dimension embeddings and reranking. Never expose
# any of these with a VITE_ prefix.
GEMINI_API_KEY=
GROQ_API_KEY=
JINA_API_KEY=

# Optional JSON array overriding the default free model order. Every entry must
# declare tier "free":
# [{"providerId":"gemini","modelId":"gemini-3.5-flash-lite","tier":"free"}]
AI_MODEL_PREFERENCES=
